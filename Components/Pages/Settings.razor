@page "/settings"
@inject kechap.Services.TimerSettingsService SettingsService

<div class="settings-page">
    <h1>Timer Customization ⚙️</h1>

    <div class="settings-card">
        <div class="setting-row">
            <label>Pomodoro Duration (mins)</label>
            <input type="number" @bind="pomodoroMins" min="1" max="120" />
        </div>
        <div class="setting-row">
            <label>Short Break Duration (mins)</label>
            <input type="number" @bind="shortBreakMins" min="1" max="60" />
        </div>
        <div class="setting-row">
            <label>Long Break Duration (mins)</label>
            <input type="number" @bind="longBreakMins" min="1" max="60" />
        </div>

        <button class="save-btn" @onclick="SaveSettings">Save Changes</button>

        @if (showSaved)
        {
            <div class="saved-note">✔ Saved!</div>
        }
    </div>
</div>

@code {
    private int pomodoroMins;
    private int shortBreakMins;
    private int longBreakMins;
    private bool showSaved = false;

    protected override void OnInitialized()
    {
        pomodoroMins = SettingsService.PomodoroMinutes;
        shortBreakMins = SettingsService.ShortBreakMinutes;
        longBreakMins = SettingsService.LongBreakMinutes;
    }

    private async Task SaveSettings()
    {
        SettingsService.PomodoroMinutes = pomodoroMins;
        SettingsService.ShortBreakMinutes = shortBreakMins;
        SettingsService.LongBreakMinutes = longBreakMins;

        showSaved = true;
        StateHasChanged();
        await Task.Delay(1500);
        showSaved = false;
    }
}