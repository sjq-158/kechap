@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<div class="page-wrapper @BackgroundClass" data-theme="@(isDark ? "dark" : "light")">
    <nav class="top-navbar">
        <NavLink href="" Match="NavLinkMatch.All" class="logo-link">
            <img src="images/tomato-icon.svg" alt="tomato" class="logo-icon" />
            <span class="logo-text">KeChap</span>
        </NavLink>

        <div class="nav-links">
            <NavLink href="report" class="nav-item">
                <img src="images/report-icon.svg" alt="" /> Report
            </NavLink>
            <NavLink href="settings" class="nav-item">
                <img src="images/settings-icon.svg" alt="" /> Setting
            </NavLink>
            <button class="theme-toggle" @onclick="ToggleTheme">
                @(isDark ? "☀️ Light" : "🌙 Dark")
            </button>
        </div>
    </nav>

    <main class="content">
        @Body
    </main>
</div>

@code {
    private bool isDark = false;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private string BackgroundClass =>
        string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri)) ? "bg-timer" : "bg-app";

    private void ToggleTheme() => isDark = !isDark;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}